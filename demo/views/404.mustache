<div class="pa-card">
    <div class="pa-card__body text-center" style="padding: 4rem 1.5rem;">
        <!-- Muted compass-off glyph in an accent-tinted disc -->
        <div class="surface-info" style="width: 6.4rem; height: 6.4rem; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 1.5rem;">
            <svg xmlns="http://www.w3.org/2000/svg" width="3.2rem" height="3.2rem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16.24 7.76-1.804 5.411a2 2 0 0 1-1.265 1.265L7.76 16.24l1.804-5.411a2 2 0 0 1 1.265-1.265z"/><circle cx="12" cy="12" r="10"/></svg>
        </div>

        <div style="font-size: 7.2rem; line-height: 1; font-weight: 700;" class="text-secondary">404</div>

        <h2 class="mt-4 mb-2">Page not found</h2>

        <p class="text-secondary mb-2">
            We couldn&rsquo;t find <code>{{requestedPath}}</code>.
        </p>
        <p class="text-sm text-secondary mb-4" style="max-width: 42rem; margin-inline: auto;">
            The page may have moved or never existed. Pick a component from the sidebar,
            or jump straight to one with the command palette
            (<strong>Ctrl</strong>&nbsp;/&nbsp;<strong>&#8984;</strong>&nbsp;+&nbsp;<strong>K</strong>).
        </p>

        <div class="pa-btn-group">
            <a href="/" class="pa-btn pa-btn--primary">&larr; Back to dashboard</a>
            <a href="/components" class="pa-btn pa-btn--secondary">Browse components</a>
        </div>
    </div>
</div>
