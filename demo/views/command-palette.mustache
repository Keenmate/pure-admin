        <script>
            // Display style toggle
            function setCpDisplayStyle(style) {
                if (window.commandPalette) {
                    window.commandPalette.setDisplayStyle(style);
                } else {
                    console.warn('Command palette not initialized yet');
                }
                document.getElementById('cpDemoInlineBtn').className = 'pa-btn pa-btn--sm ' + (style === 'inline' ? 'pa-btn--primary' : 'pa-btn--secondary');
                document.getElementById('cpDemoTokensBtn').className = 'pa-btn pa-btn--sm ' + (style === 'tokens' ? 'pa-btn--primary' : 'pa-btn--secondary');
            }

            // Helper function to open palette with pre-filled query
            function openPaletteWithQuery(query) {
                const palette = document.getElementById('commandPalette');
                const input = document.getElementById('commandPaletteInput');

                palette.classList.add('pa-command-palette--active');
                document.body.style.overflow = 'hidden';

                // Set value and trigger input event
                setTimeout(() => {
                    input.value = query;
                    input.focus();
                    input.dispatchEvent(new Event('input'));
                }, 100);
            }

            // Add kbd styling
            document.querySelectorAll('kbd').forEach(kbd => {
                if (!kbd.classList.length) {
                    kbd.className = 'pa-command-palette__key';
                }
            });
        </script>
