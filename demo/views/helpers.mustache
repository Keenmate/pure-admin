                </tr>
                <tr>
                    <td>Fraction</td>
                    <td><code>h-{1-2|1-3|2-3|1-4|3-4}</code></td>
                    <td><code>minh-{1-2|1-3|2-3|1-4|3-4}</code></td>
                    <td><code>maxh-{1-2|1-3|2-3|1-4|3-4}</code></td>
                </tr>
                <tr>
                    <td>REM</td>
                    <td><code>hr-{1-10}</code>, then <code>hr-{15|20|&hellip;|50}</code></td>
