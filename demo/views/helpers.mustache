<!-- Position & Border -->
<div class="pa-card">
    <div class="pa-card__header">
        <div class="pa-card__title">
            <h3 class="pa-card__title-text">Position &amp; Border Utilities</h3>
        </div>
    </div>
    <div class="pa-card__body">
        <table class="pa-table pa-table--striped pa-table--sm mb-4">
            <thead>
                <tr>
                    <th>Category</th>
                    <th>Classes</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Position</td>
                    <td><code>position-{static|relative|absolute|fixed|sticky}</code></td>
                </tr>
                <tr>
                    <td>Border (add)</td>
                    <td><code>border</code>, <code>border-top</code>, <code>border-bottom</code>, <code>border-start</code>, <code>border-end</code></td>
                </tr>
                <tr>
                    <td>Border (remove)</td>
                    <td><code>border-0</code>, <code>border-top-0</code>, <code>border-bottom-0</code>, <code>border-start-0</code>, <code>border-end-0</code></td>
                </tr>
                <tr>
                    <td>Border style</td>
                    <td><code>border-{solid|dashed|dotted|none}</code></td>
                </tr>
                <tr>
                    <td>Radius</td>
                    <td><code>rounded</code>, <code>rounded-lg</code>, <code>rounded-circle</code>, <code>rounded-0</code></td>
                </tr>
                <tr>
                    <td>Radius (sides)</td>
                    <td><code>rounded-top</code>, <code>rounded-bottom</code>, <code>rounded-start</code>, <code>rounded-end</code></td>
                </tr>
            </tbody>
        </table>
        <p class="text-sm text-muted mb-4">Start / end follow the writing direction like the logical spacing,
            so they mirror under <code>dir="rtl"</code>. There are no <code>-left</code> / <code>-right</code> variants.</p>

        <h4>Live Examples</h4>
        <div class="d-flex gap-lg flex-wrap">
            <div class="p-md rounded-0" style="background: var(--pc-primary-bg-subtle);">rounded-0</div>
            <div class="p-md rounded" style="background: var(--pc-primary-bg-subtle);">rounded</div>
            <div class="p-md rounded-lg" style="background: var(--pc-primary-bg-subtle);">rounded-lg</div>
            <div class="p-md rounded-start" style="background: var(--pc-primary-bg-subtle);">rounded-start</div>
            <div class="p-lg rounded-circle" style="background: var(--pc-primary-bg-subtle);">circle</div>
            <div class="p-md border-start" style="border-width: 0.4rem !important;">border-start</div>
            <div class="p-md border border-dashed">border-dashed</div>
        </div>
    </div>
</div>

<!-- Shadow Utilities -->
<div class="pa-card">
    <div class="pa-card__header">
        <div class="pa-card__title">
            <h3 class="pa-card__title-text">Shadow Utilities</h3>
        </div>
    </div>
    <div class="pa-card__body">
        <p class="text-sm mb-4">
            Classes: <code>shadow-none</code>, <code>shadow-sm</code>, <code>shadow</code>, <code>shadow-lg</code>
        </p>
        <div class="d-flex gap-lg flex-wrap">
            <div class="p-lg shadow-none" style="background: var(--pa-card-bg);">shadow-none</div>
            <div class="p-lg shadow-sm" style="background: var(--pa-card-bg);">shadow-sm</div>
            <div class="p-lg shadow" style="background: var(--pa-card-bg);">shadow</div>
            <div class="p-lg shadow-lg" style="background: var(--pa-card-bg);">shadow-lg</div>
        </div>
    </div>
</div>

<!-- Miscellaneous -->
<div class="pa-card">
    <div class="pa-card__header">
        <div class="pa-card__title">
            <h3 class="pa-card__title-text">Miscellaneous</h3>
        </div>
    </div>
    <div class="pa-card__body">
        <table class="pa-table pa-table--striped pa-table--sm mb-4">
            <thead>
                <tr>
                    <th>Class</th>
                    <th>What it does</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><code>rotate-{90|180|270}</code></td>
                    <td>Rotates the element (the box stays horizontal &mdash; for a narrow vertical label use <code>text-vertical</code>)</td>
                </tr>
                <tr>
                    <td><code>unstyled</code></td>
                    <td>On a <code>&lt;ul&gt;</code> / <code>&lt;ol&gt;</code>: no bullets, no indent</td>
                </tr>
                <tr>
                    <td><code>compact-mode</code></td>
                    <td>On a container (or <code>&lt;body&gt;</code>): tighter card bodies, table cells, sidebar links and form groups</td>
                </tr>
                <tr>
                    <td><code>font-size-{small|default|large|xlarge}</code></td>
                    <td>On <code>&lt;html&gt;</code>: scales the whole UI (9 / 10 / 11 / 12px root). Responsive variant:
                        <code>pa-font-base-N</code> + <code>pa-font-mobile-N</code>, or <code>pa-font-responsive</code>.
                        See <a href="/getting-started">Getting Started</a>.</td>
                </tr>
            </tbody>
        </table>

        <h4>Live Example</h4>
        <div class="d-flex gap-lg align-items-center">
            <span class="pa-icon pa-icon--chevron-right" aria-hidden="true"></span>
            <span class="pa-icon pa-icon--chevron-right rotate-90" aria-hidden="true"></span>
            <span class="pa-icon pa-icon--chevron-right rotate-180" aria-hidden="true"></span>
            <span class="pa-icon pa-icon--chevron-right rotate-270" aria-hidden="true"></span>
            <ul class="unstyled m-0">
                <li>unstyled list</li>
                <li>no bullets</li>
            </ul>
        </div>
    </div>
</div>

<!-- CSS Classes Reference -->
<div class="pa-card">
    <div class="pa-card__header">
        <div class="pa-card__title">
            <h3 class="pa-card__title-text">CSS Classes Reference</h3>
        </div>
    </div>
    <div class="pa-card__body">
        <h4>Spacing (Margin &amp; Padding)</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>m-{0-6|8|10|12|16|20}</code>, <code>p-*</code> &mdash; Numeric scale (0.25rem steps, rem)</li>
            <li><code>m-{0|xs|sm|md|base|lg|xl|2xl}</code>, <code>p-*</code> &mdash; Semantic scale</li>
            <li><code>mt-*</code>, <code>mb-*</code>, <code>mx-*</code>, <code>my-*</code> (and <code>p</code> equivalents) &mdash; Sides / axes, both scales</li>
            <li><code>ms-*</code>, <code>me-*</code>, <code>ps-*</code>, <code>pe-*</code> &mdash; Start / end (mirror under RTL), both scales</li>
            <li><code>m-auto</code>, <code>mx-auto</code>, <code>my-auto</code>, <code>mt-auto</code>, <code>mb-auto</code>, <code>ms-auto</code>, <code>me-auto</code> &mdash; Auto margins</li>
        </ul>

        <h4 class="mt-4">Gap</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>gap-{0|xs|sm|md|base|lg|xl|2xl}</code>, <code>row-gap-*</code>, <code>column-gap-*</code> &mdash; Semantic</li>
            <li><code>gap-{0-6|8|10|12|16|20}</code>, <code>gap-x-*</code>, <code>gap-y-*</code> &mdash; Numeric</li>
        </ul>

        <h4 class="mt-4">Width</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>w-{5-100}</code> (5% steps), <code>w-auto</code>, <code>w-{1-2|1-3|2-3|1-4|3-4}</code></li>
            <li><code>minw-{5-100}</code>, <code>minw-{1-3|2-3}</code>, <code>maxw-{5-100}</code>, <code>maxw-{1-2|1-3|2-3|1-4|3-4}</code></li>
            <li><code>wr-</code>, <code>minwr-</code>, <code>maxwr-{1-10|15|20|25|30|35|40|45|50}</code> &mdash; REM</li>
            <li><code>w-{25|50|75|100}-fixed</code> &mdash; Fixed width (min-width + width)</li>
        </ul>

        <h4 class="mt-4">Height</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>h-{25|50|75|100|auto}</code>, <code>h-{1-2|1-3|2-3|1-4|3-4}</code></li>
            <li><code>minh-</code>, <code>maxh-{5-100}</code> (5% steps) and fractions</li>
            <li><code>hr-</code>, <code>maxhr-{1-10|15|20|25|30|35|40|45|50}</code>, <code>minhr-</code> (same + <code>60|70|80|90|100</code>) &mdash; REM</li>
            <li><code>h-full</code>, <code>h-screen</code>, <code>min-h-{full|screen}</code>, <code>max-h-{full|screen}</code></li>
        </ul>

        <h4 class="mt-4">Display</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>d-none</code>, <code>d-block</code>, <code>d-inline</code>, <code>d-inline-block</code>, <code>d-flex</code>, <code>d-inline-flex</code></li>
        </ul>

        <h4 class="mt-4">Flexbox</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>flex-row</code>, <code>flex-column</code>, <code>flex-wrap</code>, <code>flex-nowrap</code></li>
            <li><code>justify-content-{start|end|center|between|around}</code></li>
            <li><code>align-items-{start|end|center|baseline|stretch}</code>, <code>self-{start|center|end|stretch|baseline}</code></li>
            <li><code>flex-{1|auto|initial|none|fill}</code>, <code>flex-grow</code>, <code>flex-grow-{0|1}</code>, <code>flex-shrink</code>, <code>flex-shrink-{0|1}</code></li>
        </ul>

        <h4 class="mt-4">Text &amp; Font</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>text-{start|center|end}</code>, <code>text-nowrap</code>, <code>text-truncate</code></li>
            <li><code>text-{2xs|xs|sm|md|base|lg|xl|2xl|3xl|4xl}</code> &mdash; Font size</li>
            <li><code>text-body</code>, <code>text-muted</code> (muted), <code>text-{primary|success|danger|warning|info}</code></li>
            <li><code>font-weight-{normal|medium|semibold|bold}</code>, <code>font-style-{normal|italic}</code>, <code>font-family-{system|sans|serif|mono}</code></li>
            <li><code>text-vertical</code>, <code>text-vertical-up</code></li>
        </ul>

        <h4 class="mt-4">Colour</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>surface-{role}</code>, <code>bg-{role}</code>, <code>text-on-{role}</code> &mdash; role = primary|secondary|success|danger|warning|info</li>
            <li><code>surface-color-N</code>, <code>bg-color-N</code>, <code>text-color-N</code>, <code>text-on-color-N</code>, <code>border-color-N</code> &mdash; Colour slots 1&ndash;9 (see Colors)</li>
        </ul>

        <h4 class="mt-4">Overflow &amp; Cursor</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>overflow-{auto|hidden|visible}</code>, <code>overflow-{x|y}-auto</code>, <code>overflow-overlay</code>, <code>overflow-{x|y}-overlay</code></li>
            <li><code>cursor-{pointer|help|wait|not-allowed|text|move|default|grab|grabbing|zoom-in|zoom-out}</code></li>
        </ul>

        <h4 class="mt-4">Position &amp; Border</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>position-{static|relative|absolute|fixed|sticky}</code></li>
            <li><code>border</code>, <code>border-{top|bottom|start|end}</code>, <code>border-0</code>, <code>border-{top|bottom|start|end}-0</code></li>
            <li><code>border-{solid|dashed|dotted|none}</code></li>
            <li><code>rounded</code>, <code>rounded-lg</code>, <code>rounded-circle</code>, <code>rounded-0</code>, <code>rounded-{top|bottom|start|end}</code></li>
        </ul>

        <h4 class="mt-4">Shadow &amp; Misc</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>shadow-none</code>, <code>shadow-sm</code>, <code>shadow</code>, <code>shadow-lg</code></li>
            <li><code>rotate-{90|180|270}</code>, <code>unstyled</code> (lists), <code>compact-mode</code>, <code>html.font-size-*</code></li>
        </ul>
    </div>
</div>
