<!-- Width Utilities -->
<div class="pa-card">
    <div class="pa-card__header">
        <div class="pa-card__title">
            <h3 class="pa-card__title-text">Width Utilities</h3>
        </div>
    </div>
    <div class="pa-card__body">
        <table class="pa-table pa-table--striped pa-table--sm mb-4">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Width</th>
                    <th>Min-width</th>
                    <th>Max-width</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Percent (5% steps)</td>
                    <td><code>w-{5-100}</code>, <code>w-auto</code></td>
                    <td><code>minw-{5-100}</code></td>
                    <td><code>maxw-{5-100}</code></td>
                </tr>
                <tr>
                    <td>Fraction</td>
                    <td><code>w-{1-2|1-3|2-3|1-4|3-4}</code></td>
                    <td><code>minw-{1-3|2-3}</code></td>
                    <td><code>maxw-{1-2|1-3|2-3|1-4|3-4}</code></td>
                </tr>
                <tr>
                    <td>REM</td>
                    <td><code>wr-{1-10}</code>, then <code>wr-{15|20|&hellip;|50}</code></td>
                    <td><code>minwr-*</code> (same steps)</td>
                    <td><code>maxwr-*</code> (same steps)</td>
                </tr>
                <tr>
                    <td>Fixed (min-width + width)</td>
                    <td colspan="3"><code>w-{25|50|75|100}-fixed</code> &mdash; won't shrink below its width in a flex row</td>
                </tr>
            </tbody>
        </table>

        <h4>Live Example</h4>
