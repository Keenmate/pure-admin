<!-- The masked primitive -->
<!-- ============================================================ -->
<div class="pa-card">
    <div class="pa-card__header">
        <div class="pa-card__title">
            <h3 class="pa-card__title-text">The masked icon primitive</h3>
        </div>
    </div>
    <div class="pa-card__body">
        <p>Each icon is a <code>&lt;span class="pa-icon pa-icon--<em>name</em>"&gt;</code>.
            The glyph is an SVG <code>mask</code>; the box is painted in
            <code>currentColor</code> and shows through it. That means an icon
            automatically matches its surrounding text colour and scales with
            <code>font-size</code> (default <code>1em</code>, override with
            <code>--pa-icon-size</code>).</p>
        <div class="component-showcase" style="align-items: center; gap: 1.5rem;">
            <span class="pa-icon pa-icon--search" style="--pa-icon-size: 1.2rem;"></span>
            <span class="pa-icon pa-icon--search" style="--pa-icon-size: 1.6rem;"></span>
            <span class="pa-icon pa-icon--search" style="--pa-icon-size: 2.4rem;"></span>
            <span class="pa-icon pa-icon--search" style="--pa-icon-size: 3.2rem;"></span>
            <span class="pa-icon pa-icon--search" style="--pa-icon-size: 2.4rem; color: var(--pc-accent);"></span>
            <span class="pa-icon pa-icon--search" style="--pa-icon-size: 2.4rem; color: var(--pc-danger);"></span>
        </div>
        <p class="pa-text pa-text--secondary" style="margin-top: 1rem;">Same class,
            sized with <code>--pa-icon-size</code> and coloured with
            <code>color</code> / <code>currentColor</code>.</p>
    </div>
</div>

