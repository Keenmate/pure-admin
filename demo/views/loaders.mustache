<!-- CSS Classes Reference -->
<div class="pa-card">
    <div class="pa-card__header">
        <div class="pa-card__title">
            <h3 class="pa-card__title-text">CSS Classes Reference</h3>
        </div>
    </div>
    <div class="pa-card__body">
        <h4>Spinner</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>pa-spinner</code> - Base spinner (border-based rotation)</li>
            <li><code>pa-spinner--xs</code> - Extra small</li>
            <li><code>pa-spinner--sm</code> - Small (default)</li>
            <li><code>pa-spinner--md</code> - Medium</li>
            <li><code>pa-spinner--lg</code> - Large</li>
            <li><code>pa-spinner--xl</code> - Extra large</li>
            <li><code>pa-spinner--2xl</code> - 2x extra large</li>
        </ul>

        <h4 class="mt-4">Spinner Colors</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>pa-spinner--primary</code> - Primary/accent color</li>
            <li><code>pa-spinner--secondary</code> - Secondary/muted</li>
            <li><code>pa-spinner--success</code> - Success (green)</li>
            <li><code>pa-spinner--danger</code> - Danger (red)</li>
            <li><code>pa-spinner--warning</code> - Warning (yellow)</li>
            <li><code>pa-spinner--info</code> - Info (blue)</li>
        </ul>

        <h4 class="mt-4">Loader Types</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>pa-loader-dots</code> - Three bouncing dots (needs 3 &lt;span&gt;)</li>
            <li><code>pa-loader-dots--lg</code> - Large dots</li>
            <li><code>pa-loader-bars</code> - Five scaling bars (needs 5 &lt;span&gt;)</li>
            <li><code>pa-loader-bars--lg</code> - Large bars</li>
            <li><code>pa-loader-pulse</code> - Pulsing circle</li>
            <li><code>pa-loader-pulse--lg</code> - Large pulse</li>
            <li><code>pa-loader-ring</code> - Double-arc spinning ring</li>
            <li><code>pa-loader-ring--lg</code> - Large ring</li>
            <li><code>pa-loader-wave</code> - Five rounded pills bobbing in a travelling wave (needs 5 &lt;span&gt;)</li>
            <li><code>pa-loader-wave--lg</code> - Large wave</li>
            <li><code>pa-loader-grid</code> - 3×3 dots pulsing on a diagonal wave (needs 9 &lt;span&gt;)</li>
            <li><code>pa-loader-grid--lg</code> - Large grid</li>
            <li><code>pa-loader-ripple</code> - Concentric rings expanding from the centre (CSS-only)</li>
            <li><code>pa-loader-ripple--lg</code> - Large ripple</li>
            <li><code>pa-loader-dual-ring</code> - Two arcs counter-rotating (CSS-only)</li>
            <li><code>pa-loader-dual-ring--lg</code> - Large dual ring</li>
        </ul>

        <h4 class="mt-4">Loader Utilities</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>pa-loader-overlay</code> - Semi-transparent overlay (absolute positioned)</li>
            <li><code>pa-loader-center</code> - Flex container for centering loader + text</li>
        </ul>
    </div>
</div>
