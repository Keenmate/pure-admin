<!-- CSS Classes Reference -->
<div class="pa-card">
    <div class="pa-card__header">
        <div class="pa-card__title">
            <h3 class="pa-card__title-text">CSS Classes Reference</h3>
        </div>
    </div>
    <div class="pa-card__body">
        <h4>Pager Component</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>pa-pager</code> - Pager container (centered by default)</li>
            <li><code>pa-pager--start</code> - Start-align pager</li>
            <li><code>pa-pager--center</code> - Center-align pager (default)</li>
            <li><code>pa-pager--end</code> - End-align pager</li>
            <li><code>pa-pager__container</code> - Inner container for pager content</li>
            <li><code>pa-pager__controls</code> - Container for navigation buttons</li>
            <li><code>pa-pager__info</code> - Container for page info display</li>
            <li><code>pa-pager__input</code> - Page number input field</li>
            <li><code>pa-pager__text</code> - Text labels (e.g., "Page", "of 10")</li>
        </ul>

        <h4 class="mt-4">Load More Component</h4>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>pa-load-more</code> - Load more container (centered by default)</li>
            <li><code>pa-load-more--start</code> - Start-align load more</li>
            <li><code>pa-load-more--center</code> - Center-align load more (default)</li>
            <li><code>pa-load-more--end</code> - End-align load more</li>
            <li><code>pa-load-more__button</code> - The load more button</li>
            <li><code>pa-load-more__button--loading</code> - Loading state for button</li>
            <li><code>pa-load-more__spinner</code> - Loading spinner element</li>
            <li><code>pa-load-more__text</code> - Button text</li>
            <li><code>pa-load-more__count</code> - Item count display</li>
        </ul>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const loadMoreBtn = document.getElementById('load-more-demo');
    if (loadMoreBtn) {
        loadMoreBtn.addEventListener('click', function() {
            const btn = this;
            const originalHTML = btn.innerHTML;

            btn.classList.add('pa-load-more__button--loading');
            btn.innerHTML = '<span class="pa-load-more__spinner"></span><span class="pa-load-more__text">Loading...</span>';

            setTimeout(() => {
                btn.classList.remove('pa-load-more__button--loading');
                btn.innerHTML = originalHTML;
            }, 2000);
        });
    }

    // Slider pager: buttons / input / scrubber all drive one page number.
    document.querySelectorAll('[data-pager-slider]').forEach(function (pager) {
        const range = pager.querySelector('[data-range]');
        const input = pager.querySelector('.pa-pager__input');
        const loaded = pager.parentNode.querySelector('[data-pager-loaded]');
        const max = Number(range.dataset.max);
        let page = 1;

        function show(p) {
            input.value = p;
            pager.querySelector('[data-page-first]').disabled = p <= 1;
            pager.querySelector('[data-page-prev]').disabled = p <= 1;
            pager.querySelector('[data-page-next]').disabled = p >= max;
            pager.querySelector('[data-page-last]').disabled = p >= max;
        }
        function go(p) {
            page = Math.min(max, Math.max(1, Math.round(p) || 1));
            window.pureAdmin.components.range.setValue(range, page);
            show(page);
            if (loaded) loaded.textContent = 'page ' + page;
        }

        range.addEventListener('pa-range:change', function (e) { show(e.detail.value); });
        range.addEventListener('pa-range:commit', function (e) { go(e.detail.value); });
        input.addEventListener('change', function () { go(Number(input.value)); });
        pager.querySelector('[data-page-first]').addEventListener('click', function () { go(1); });
        pager.querySelector('[data-page-prev]').addEventListener('click', function () { go(page - 1); });
        pager.querySelector('[data-page-next]').addEventListener('click', function () { go(page + 1); });
        pager.querySelector('[data-page-last]').addEventListener('click', function () { go(max); });
        show(page);

        // Narrow cards: let Fit shed the data-pc-fit slots (first/last → "/ N" → prev/next).
        window.pureCss.components.fit.init(pager.querySelector('.pa-pager__container'));
    });
});
</script>
