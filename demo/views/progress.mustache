<script>
(function () {
    var $ = function (id) { return document.getElementById(id); };
    var value = $('pp-value'), variant = $('pp-variant'), size = $('pp-size'), label = $('pp-label');
    var striped = $('pp-striped'), animated = $('pp-animated');
    var output = $('pp-output'), markup = $('pp-markup');
    var esc = function (s) { return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); };

    function render() {
        var v = Math.max(0, Math.min(100, parseInt(value.value, 10) || 0));
        var cls = ['pa-progress'];
        if (size.value) cls.push('pa-progress--' + size.value);
        if (variant.value) cls.push('pa-progress--' + variant.value);
        if (striped.checked) cls.push('pa-progress--striped');
        if (animated.checked) cls.push('pa-progress--animated');
        var bar = '<div class="' + cls.join(' ') + '" role="progressbar" aria-valuenow="' + v + '" aria-valuemin="0" aria-valuemax="100">\n'
            + '  <div class="pa-progress__fill" style="--value: ' + v + '%"></div>\n</div>';
        var html = bar;
        if (label.value.trim()) {
            html = '<div class="pa-progress-group">\n'
                + '  <div class="pa-progress__label">\n'
                + '    <span>' + esc(label.value.trim()) + '</span>\n'
                + '    <span class="pa-progress__label-value">' + v + '%</span>\n'
                + '  </div>\n'
                + bar.replace(/^/gm, '  ') + '\n</div>';
        }
        output.innerHTML = html;
        markup.textContent = html;
    }

    [value, variant, size, label, striped, animated].forEach(function (el) {
        el.addEventListener('input', render);
        el.addEventListener('change', render);
    });
    document.querySelectorAll('[data-pp-step]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            value.value = Math.max(0, Math.min(100, (parseInt(value.value, 10) || 0) + parseInt(btn.dataset.ppStep, 10)));
            render();
        });
    });
    var timer = null;
    document.querySelector('[data-pp-run]').addEventListener('click', function () {
        clearInterval(timer);
        value.value = 0;
        render();
        timer = setInterval(function () {
            var next = (parseInt(value.value, 10) || 0) + 5;
            value.value = Math.min(100, next);
            render();
            if (next >= 100) clearInterval(timer);
        }, 150);
    });
    render();
})();
</script>
