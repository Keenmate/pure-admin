<script>
(function () {
    var $ = function (id) { return document.getElementById(id); };
    var value = $('pp-value'), variant = $('pp-variant'), size = $('pp-size'), label = $('pp-label');
    var striped = $('pp-striped'), animated = $('pp-animated');
    var output = $('pp-output'), markup = $('pp-markup');
    var esc = function (s) { return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); };

    function render() {
        var v = Math.max(0, Math.min(100, parseInt(value.value, 10) || 0));
        var cls = ['pa-progress'];
        if (size.value) cls.push('pa-progress--' + size.value);
        if (variant.value) cls.push('pa-progress--' + variant.value);
        if (striped.checked) cls.push('pa-progress--striped');
        if (animated.checked) cls.push('pa-progress--animated');
        var bar = '<div class="' + cls.join(' ') + '" role="progressbar" aria-valuenow="' + v + '" aria-valuemin="0" aria-valuemax="100">\n'
            + '  <div class="pa-progress__fill" style="--value: ' + v + '%"></div>\n</div>';
        var html = bar;
        if (label.value.trim()) {
            html = '<div class="pa-progress-group">\n'
                + '  <div class="pa-progress__label">\n'
                + '    <span>' + esc(label.value.trim()) + '</span>\n'
                + '    <span class="pa-progress__label-value">' + v + '%</span>\n'
                + '  </div>\n'
                + bar.replace(/^/gm, '  ') + '\n</div>';
        }
        output.innerHTML = html;
        markup.textContent = html;
    }

    [value, variant, size, label, striped, animated].forEach(function (el) {
        el.addEventListener('input', render);
        el.addEventListener('change', render);
    });
    document.querySelectorAll('[data-pp-step]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            value.value = Math.max(0, Math.min(100, (parseInt(value.value, 10) || 0) + parseInt(btn.dataset.ppStep, 10)));
            render();
        });
    });
    var timer = null;
    document.querySelector('[data-pp-run]').addEventListener('click', function () {
        clearInterval(timer);
        value.value = 0;
        render();
        timer = setInterval(function () {
            var next = (parseInt(value.value, 10) || 0) + 5;
            value.value = Math.min(100, next);
            render();
            if (next >= 100) clearInterval(timer);
        }, 150);
    });
    render();
})();

// --- Prototype: phase editor (the script plays the wrapper) --------------------
(function () {
    var form = document.getElementById('phase-editor');
    if (!form) return;
    var $ = function (id) { return document.getElementById(id); };
    var value = $('ph-value'), mode = $('ph-mode'), preset = $('ph-preset'), rowsEl = $('ph-rows');
    var bar = $('ph-bar'), fill = bar.querySelector('.pa-progress__fill');
    var COLORS = ['danger', 'warning', '--our-yellow', 'success', 'info', 'primary', 'secondary',
                  '1', '2', '3', '4', '5', '6', '7', '8', '9'];
    var PRESETS = {
        health: [{ at: 0, color: 'danger' }, { at: 40, color: 'warning' }, { at: 70, color: '--our-yellow' }, { at: 90, color: 'success' }],
        usage: [{ at: 0, color: 'success' }, { at: 60, color: 'warning' }, { at: 85, color: 'danger' }],
        palette: [{ at: 0, color: '1' }, { at: 33, color: '2' }, { at: 66, color: '3' }, { at: 100, color: '4' }]
    };
    var phases = PRESETS.health.slice();

    // colour name -> CSS colour (what core / the wrapper would resolve)
    function css(c) {
        if (/^[1-9]$/.test(c)) return 'var(--pc-palette-' + c + ')';
        if (c.indexOf('--') === 0) return 'var(' + c + ')';   // any custom CSS variable
        return 'var(--pc-' + c + '-color)';
    }
    // colour name -> existing class (value mode: no new CSS needed)
    function cls(c) {
        if (/^[1-9]$/.test(c)) return 'pa-progress--color-' + c;
        if (['success', 'warning', 'danger', 'info'].indexOf(c) < 0) return '';
        if (c.indexOf('--') === 0) return '';   // custom colour: no class, painted inline (see render)
        return 'pa-progress--' + c;
    }
    function stops() {
        var sorted = phases.slice().sort(function (a, b) { return a.at - b.at; });
        if (mode.value === 'zoned') {
            return sorted.map(function (p, i) {
                var end = i + 1 < sorted.length ? sorted[i + 1].at : 100;
                return css(p.color) + ' ' + p.at + '% ' + end + '%';
            }).join(', ');
        }
        return sorted.map(function (p) { return css(p.color) + ' ' + p.at + '%'; }).join(', ');
    }
    function currentPhase(v) {
        var sorted = phases.slice().sort(function (a, b) { return a.at - b.at; });
        var hit = sorted[0];
        sorted.forEach(function (p) { if (v >= p.at) hit = p; });
        return hit;
    }
    function drawRows() {
        rowsEl.innerHTML = '';
        phases.forEach(function (p, i) {
            var col = document.createElement('div');
            col.className = 'pc-col-50 pc-col-md-1-4';
            var opts = COLORS.map(function (c) {
                return '<option value="' + c + '"' + (c === p.color ? ' selected' : '') + '>' + (/^[1-9]$/.test(c) ? 'color-' + c : c.indexOf('--') === 0 ? c + ' (custom)' : c) + '</option>';
            }).join('');
            col.innerHTML = '<div class="pa-form-group"><label>Phase ' + (i + 1) + ' — from %</label>'
                + '<input type="number" class="pa-input mb-2" min="0" max="100" step="5" value="' + p.at + '" data-i="' + i + '" data-k="at">'
                + '<select class="pa-select" data-i="' + i + '" data-k="color">' + opts + '</select></div>';
            rowsEl.appendChild(col);
        });
    }
    function render() {
        var v = Math.max(0, Math.min(100, parseInt(value.value, 10) || 0));
        var sorted = phases.slice().sort(function (a, b) { return a.at - b.at; });
        bar.className = 'pa-progress pa-progress--lg';
        bar.removeAttribute('style');
        var html, phaseAttr;
        if (mode.value === 'value') {
            var ph = currentPhase(v).color, c = cls(ph);
            var custom = !c && ph !== 'primary';
            if (c) bar.classList.add(c);
            if (custom) bar.style.setProperty('--pa-progress-fill', css(ph));
            html = '<div class="pa-progress' + (c ? ' ' + c : '') + '"' + (custom ? ' style="--pa-progress-fill: ' + css(ph) + '"' : '') + ' role="progressbar" aria-valuenow="' + v + '" …>\n'
                + '  <div class="pa-progress__fill" style="--value: ' + v + '%"></div>\n</div>\n\n'
                + (custom
                    ? '<!-- value ' + v + '% is in the "' + ph + '" phase → no class for this colour, so it goes to the --pa-progress-fill token -->'
                    : '<!-- value ' + v + '% is in the "' + ph + '" phase → existing class, no new CSS -->');
        } else {
            var s = stops();
            bar.classList.add('pa-progress--phased');
            bar.style.setProperty('--pa-progress-phases', s);
            html = '<div class="pa-progress pa-progress--phased"\n'
                + '     style="--pa-progress-phases: ' + s.replace(/, /g, ',\n                                  ') + '"\n'
                + '     role="progressbar" aria-valuenow="' + v + '" …>\n'
                + '  <div class="pa-progress__fill" style="--value: ' + v + '%"></div>\n</div>';
        }
        fill.style.setProperty('--value', v + '%');
        bar.setAttribute('aria-valuenow', String(v));
        $('ph-value-text').textContent = v + '%';
        $('ph-html').textContent = html;

        var name = preset.value === 'custom' ? null : preset.value;
        var list = sorted.map(function (p) { return '{ at: ' + p.at + ', color: ' + (/^[1-9]$/.test(p.color) ? p.color : "'" + p.color + "'") + ' }'; });
        var phasesSvelte = name ? '"' + name + '"' : '{[\n    ' + list.join(',\n    ') + '\n  ]}';
        var modeSvelte = mode.value === 'smooth' ? '' : '\n  phaseMode="' + mode.value + '"';
        $('ph-svelte').textContent = '<Progress\n  value={' + v + '}\n  phases=' + phasesSvelte + modeSvelte + '\n/>';
        var listKeen = sorted.map(function (p) { return '{' + p.at + ', ' + (/^[1-9]$/.test(p.color) ? p.color : '"' + p.color + '"') + '}'; });
        var phasesKeen = name ? '"' + name + '"' : '{[' + listKeen.join(', ') + ']}';
        var modeKeen = mode.value === 'smooth' ? '' : ' phase_mode="' + mode.value + '"';
        $('ph-keen').textContent = '<.progress value={' + v + '} phases=' + phasesKeen + modeKeen + ' />';
    }

    rowsEl.addEventListener('input', function (e) {
        var i = e.target.dataset.i, k = e.target.dataset.k;
        if (i === undefined) return;
        phases[i][k] = k === 'at' ? (parseInt(e.target.value, 10) || 0) : e.target.value;
        preset.value = 'custom';
        render();
    });
    rowsEl.addEventListener('change', function (e) { rowsEl.dispatchEvent(new Event('input')); render(); });
    preset.addEventListener('change', function () {
        if (PRESETS[preset.value]) { phases = PRESETS[preset.value].map(function (p) { return { at: p.at, color: p.color }; }); drawRows(); }
        render();
    });
    [value, mode].forEach(function (el) { el.addEventListener('input', render); el.addEventListener('change', render); });
    var timer = null;
    $('ph-run').addEventListener('click', function () {
        clearInterval(timer);
        value.value = 0;
        render();
        timer = setInterval(function () {
            var next = (parseInt(value.value, 10) || 0) + 2;
            value.value = Math.min(100, next);
            render();
            if (next >= 100) clearInterval(timer);
        }, 40);
    });
    drawRows();
    render();
})();

// --- Prototype: vertical bars --------------------------------------------------
(function () {
    var run = document.getElementById('proto-vertical-run');
    if (!run) return;
    var bars = document.querySelectorAll('#proto-vertical .pa-progress');
    run.addEventListener('click', function () {
        bars.forEach(function (b) {
            var v = Math.round(Math.random() * 100);
            b.querySelector('.pa-progress__fill').style.setProperty('--value', v + '%');
            b.setAttribute('aria-valuenow', String(v));
        });
    });
    var meter = document.querySelectorAll('#proto-meter .pa-progress');
    var toggle = document.getElementById('proto-meter-toggle');
    var timer = null;
    toggle.addEventListener('click', function () {
        if (timer) { clearInterval(timer); timer = null; toggle.textContent = 'Start meter'; return; }
        toggle.textContent = 'Stop meter';
        timer = setInterval(function () {
            meter.forEach(function (b, i) {
                var base = 70 - Math.abs(i - 3) * 12;
                var v = Math.max(5, Math.min(100, base + Math.round((Math.random() - 0.5) * 50)));
                b.querySelector('.pa-progress__fill').style.setProperty('--value', v + '%');
                b.setAttribute('aria-valuenow', String(v));
            });
        }, 180);
    });
})();

// --- Prototype: multi-step form ---------------------------------------------
(function () {
    var items = document.querySelectorAll('#proto-steps .pa-steps__item');
    var panes = document.querySelectorAll('[data-proto-step]');
    var bar = document.getElementById('proto-steps-bar');
    var text = document.getElementById('proto-steps-text');
    var back = document.getElementById('proto-back');
    var next = document.getElementById('proto-next');
    if (!items.length) return;
    var total = items.length, current = 0;

    function show() {
        items.forEach(function (li, i) {
            li.classList.toggle('pa-steps__item--done', i < current);
            li.classList.toggle('pa-steps__item--current', i === current);
            if (i === current) li.setAttribute('aria-current', 'step'); else li.removeAttribute('aria-current');
            li.querySelector('.pa-steps__marker').textContent = i < current ? '✓' : String(i + 1);
        });
        panes.forEach(function (p) { p.hidden = Number(p.dataset.protoStep) !== current; });
        // the bar shows completed steps (current one is in progress)
        bar.querySelector('.pa-progress__fill').style.setProperty('--value', (current / total * 100) + '%');
        bar.setAttribute('aria-valuenow', String(current));
        text.textContent = 'Step ' + (current + 1) + ' of ' + total;
        back.disabled = current === 0;
        next.textContent = current === total - 1 ? 'Finish' : 'Next';
    }
    back.addEventListener('click', function () { if (current > 0) { current--; show(); } });
    next.addEventListener('click', function () { if (current < total - 1) { current++; show(); } else { current = 0; show(); } });
    show();
})();
</script>
