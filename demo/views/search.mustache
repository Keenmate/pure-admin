<script>
(function () {
    var btn = document.getElementById('searchLoadMore');
    var grid = document.getElementById('searchCardsResults');
    if (!btn || !grid) return;

    // Sample batch to append on each click (icon + type), echoing the query.
    var BATCH = [
        { icon: '📁', type: 'Folder', title: '{{q}} assets', snippet: 'Shared folder with the {{q}} brand kit and exports.' },
        { icon: '📄', type: 'Page', title: '{{q}} FAQ', snippet: 'Answers to the most common questions about {{q}}.' },
        { icon: '👤', type: 'User', title: '{{q}} Horák', snippet: 'Backend engineer — owns the {{q}} search index.' },
        { icon: '📊', type: 'Report', title: '{{q}} usage, YTD', snippet: 'Adoption of {{q}} across every workspace this year.' }
    ];

    function card(it) {
        var a = document.createElement('a');
        a.className = 'pa-search-results__item';
        a.href = '#';
        a.innerHTML =
            '<span class="pa-search-results__icon" aria-hidden="true">' + it.icon + '</span>' +
            '<div class="pa-search-results__content">' +
                '<div class="pa-search-results__title"></div>' +
                '<p class="pa-search-results__snippet"></p>' +
            '</div>' +
            '<span class="pa-search-results__type"></span>';
        // Assign text via textContent so the echoed query can't inject markup.
        a.querySelector('.pa-search-results__title').textContent = it.title;
        a.querySelector('.pa-search-results__snippet').textContent = it.snippet;
        a.querySelector('.pa-search-results__type').textContent = it.type;
        return a;
    }

    btn.addEventListener('click', function () {
        var shown = parseInt(btn.dataset.shown, 10);
        var total = parseInt(btn.dataset.total, 10);
        if (shown >= total) return;

        var textEl = btn.querySelector('.pa-load-more__text');
        var countEl = btn.querySelector('.pa-load-more__count');
        var original = textEl.textContent;

        // Loading state — spinner + swapped label, matching the pagers demo.
        btn.classList.add('pa-load-more__button--loading');
        textEl.textContent = 'Loading…';
        var spinner = document.createElement('span');
        spinner.className = 'pa-load-more__spinner';
        btn.insertBefore(spinner, btn.firstChild);

        setTimeout(function () {
            var next = Math.min(4, total - shown);
            for (var i = 0; i < next; i++) grid.appendChild(card(BATCH[i % BATCH.length]));
            shown += next;
            btn.dataset.shown = shown;

            spinner.remove();
            btn.classList.remove('pa-load-more__button--loading');
            countEl.textContent = '(showing ' + shown + ' of ' + total + ')';

            if (shown >= total) {
                textEl.textContent = 'All results shown';
                btn.disabled = true;
            } else {
                textEl.textContent = original;
            }
        }, 700);
    });
})();
</script>
