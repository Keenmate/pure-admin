<template id="sx-tpl-form-body">
    <form class="pa-form" onsubmit="return false" novalidate>
        <section class="pa-sections__section" id="sx-personal">
            <h3 class="pa-sections__title">1. Personal</h3>
            <div class="pa-form-group"><label for="sx-first">First name</label><input type="text" class="pa-input" id="sx-first" required></div>
            <div class="pa-form-group"><label for="sx-last">Last name</label><input type="text" class="pa-input" id="sx-last" required></div>
            <div class="pa-form-group"><label for="sx-email">Email</label><input type="email" class="pa-input" id="sx-email" required placeholder="dale.cooper@fbi.gov"></div>
            <div class="pa-form-group"><label for="sx-phone">Phone</label><input type="tel" class="pa-input" id="sx-phone"></div>
        </section>
        <section class="pa-sections__section" id="sx-address">
            <h3 class="pa-sections__title">2. Address</h3>
            <div class="pa-form-group"><label for="sx-street">Street</label><input type="text" class="pa-input" id="sx-street" required></div>
            <div class="pa-form-group"><label for="sx-city">City</label><input type="text" class="pa-input" id="sx-city" required placeholder="Twin Peaks"></div>
            <div class="pa-form-group"><label for="sx-zip">ZIP code (5 digits)</label><input type="text" class="pa-input" id="sx-zip" required pattern="\d{5}"></div>
            <div class="pa-form-group"><label for="sx-country">Country</label><select class="pa-select" id="sx-country" required><option value="">Choose…</option><option>United States</option><option>Canada</option><option>Czechia</option></select></div>
        </section>
        <section class="pa-sections__section" id="sx-company">
            <h3 class="pa-sections__title">3. Company (optional)</h3>
            <div class="pa-form-group"><label for="sx-org">Company name</label><input type="text" class="pa-input" id="sx-org"></div>
            <div class="pa-form-group"><label for="sx-role">Role</label><input type="text" class="pa-input" id="sx-role"></div>
        </section>
        <section class="pa-sections__section" id="sx-billing">
            <h3 class="pa-sections__title">4. Billing</h3>
            <div class="pa-form-group"><label for="sx-card">Card number (16 digits)</label><input type="text" class="pa-input" id="sx-card" required pattern="\d{16}" placeholder="4111111111111111"></div>
            <div class="pa-form-group"><label for="sx-exp">Expiry (MM/YY)</label><input type="text" class="pa-input" id="sx-exp" required pattern="(0[1-9]|1[0-2])/\d{2}"></div>
            <div class="pa-form-group"><label for="sx-vat">VAT ID</label><input type="text" class="pa-input" id="sx-vat"></div>
        </section>
        <section class="pa-sections__section" id="sx-review">
            <h3 class="pa-sections__title">5. Review</h3>
            <label class="pa-checkbox mb-4">
                <input type="checkbox" id="sx-terms" required>
                <span class="pa-checkbox__box"></span>
                <span class="pa-checkbox__label">I agree to the terms</span>
            </label>
            <div class="pa-form-actions">
                <button type="button" class="pa-btn pa-btn--primary" data-sections-submit>Send</button>
            </div>
        </section>
    </form>
</template>
