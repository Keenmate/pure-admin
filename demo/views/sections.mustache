<script>
/* Demo wiring only — the controller is core's js/sections.js (window.pureAdmin.components.sections). */
(function () {
    var api = window.pureAdmin.components.sections;
    var root = document.getElementById('sx');
    var $ = function (id) { return document.getElementById(id); };
    var example = $('sx-example'), progress = $('sx-progress'), layout = $('sx-layout'), mode = $('sx-mode'), style = $('sx-style'), bar = $('sx-bar'), position = $('sx-position'), visible = $('sx-visible');
    var EXPLAIN = {
        seen: 'seen (default, strict): a step is ticked once its section\'s START and END have both been on screen through your own scrolling. Jump to 10 and 1-9 stay open until you scroll through them. "Accept" unlocks when every step is ticked.',
        passed: 'passed (lax): a step is ticked once its section is above you — a jump to 10 ticks 1-9 as well.',
        confirm: 'confirm (manual): each section ends with a footer checkbox; only ticking it ticks the step. A section you have seen but not confirmed shows a warning.',
        'confirm-after-seen': 'confirm + data-confirm-after-seen: the checkbox stays disabled until the section has been seen (start and end) — you cannot confirm what you did not scroll through.',
        fields: 'fields: steps take their colour from the section\'s fields: numbered = untouched, amber = started, red = invalid (try a 4-digit ZIP), green = complete. In wizard mode, Next only moves on from a valid page.'
    };
    var FOOTER = '<footer class="pa-sections__footer"><label class="pa-checkbox"><input type="checkbox" data-sections-confirm>'
        + '<span class="pa-checkbox__box"></span><span class="pa-checkbox__label">I have read this section</span></label></footer>';

    function clone(id) { return $(id).content.cloneNode(true); }

    function build() {
        var ctl = api.get(root);
        if (ctl) ctl.destroy();
        root.querySelector('.pa-sections__nav').replaceChildren(clone('sx-tpl-' + example.value + '-nav'));
        var body = root.querySelector('.pa-sections__body');
        body.replaceChildren(clone('sx-tpl-' + example.value + '-body'));
        body.appendChild(clone('sx-tpl-actions'));
        var confirm = progress.value.indexOf('confirm') === 0;
        root.setAttribute('data-progress', confirm ? 'confirm' : progress.value);
        if (progress.value === 'confirm-after-seen') root.setAttribute('data-confirm-after-seen', ''); else root.removeAttribute('data-confirm-after-seen');
        // confirm: every section ends with a footer holding its checkbox (before the EULA's Accept row)
        if (confirm) body.querySelectorAll('.pa-sections__section').forEach(function (sec) {
            var actions = sec.querySelector('.pa-form-actions');
            if (actions) actions.insertAdjacentHTML('beforebegin', FOOTER); else sec.insertAdjacentHTML('beforeend', FOOTER);
        });
        $('sx-explain').textContent = EXPLAIN[progress.value];
        applyClasses();
        api.init(root.parentElement);
    }

    function applyClasses() {
        var inView = root.classList.contains('pa-sections--in-view');   // runtime state — keep it
        root.className = 'pa-sections mb-8 pa-sections--' + layout.value
            + (mode.value === 'wizard' ? ' pa-sections--wizard' : '')
            + (style.value !== 'plain' ? ' pa-sections--' + style.value : '')
            + (bar.value !== 'scroll' ? ' pa-sections--' + bar.value : '')
            + (position.value ? ' pa-sections--' + position.value : '')
            + (inView ? ' pa-sections--in-view' : '');
        if (visible.value) root.setAttribute('data-overlay-steps', visible.value); else root.removeAttribute('data-overlay-steps');
        var ctl = api.get(root);
        if (ctl) ctl.refresh();
    }

    // EULA: Accept unlocks when every step is ticked
    root.addEventListener('pa-sections:change', function (e) {
        var accept = $('eula-accept');
        if (!accept) return;
        var states = e.detail.states;
        var open = states.filter(function (st) { return st !== 'done'; }).length;
        accept.disabled = open > 0;
        $('eula-hint').textContent = open ? open + ' of ' + states.length + ' sections still to go.' : 'Thanks for reading.';
    });

    example.addEventListener('change', function () {
        // a pick resets the example's defaults — but not while the saved configuration
        // is being restored (that would overwrite the restored values)
        if (!window.demoControls.isRestoring()) {
            style.value = example.value === 'form' ? 'cards' : 'boxed';
            progress.value = example.value === 'form' ? 'fields' : 'seen';
        }
        build();
    });
    progress.addEventListener('change', build);
    [layout, mode, style, bar, position, visible].forEach(function (el) { el.addEventListener('change', applyClasses); });
    style.value = example.value === 'form' ? 'cards' : 'boxed';
    progress.value = example.value === 'form' ? 'fields' : 'seen';
    build();

    // the configurator survives a reload (demo/js/controls-persistence.js)
    var persisted = window.demoControls.attach('sections');
    $('sx-reset').addEventListener('click', function () { persisted.clear(); location.reload(); });
})();
</script>
