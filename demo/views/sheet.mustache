<p>Printable <strong>paper documents</strong> — invoices, orders, quotes, receipts and payment reminders — built from a set of blocks instead of hand-rolled HTML. <code>pa-sheet</code> is the white, centred, A4-width page with a screen-only drop shadow and a built-in <code>@media&nbsp;print</code> layer. Line items reuse the ordinary <code>pa-table</code>; label/value metadata reuse <code>pa-fields</code> / <code>pa-desc-table</code>. The examples below use fictional data (Twin Peaks Ltd. &amp; friends).</p>

<div class="mb-8">
    <button type="button" class="pa-btn pa-btn--primary" onclick="window.print()">
        <span aria-hidden="true">🖨️</span> Print whole page
    </button>
    <span class="pa-text pa-text--secondary ms-2"><code>window.print()</code> prints the entire document. Each sheet below also has its own button that prints <strong>just that one sheet</strong> in isolation via <code>pureAdmin.printElement()</code> — no page-level print CSS needed.</span>
</div>

<!-- Hide the demo chrome when printing so only the sheets land on paper. -->
<style>
@media print {
    .pc-sidebar, .pc-navbar, .pc-app-header, .pc-page-header, .pc-footer,
    .sheet-demo-controls, .sheet-demo-intro { display: none !important; }
    .pc-main, .pc-content, .pc-layout__main { margin: 0 !important; padding: 0 !important; }
}
</style>


<!-- ============================================================
     EXAMPLE 1 — Standard tax invoice (gridded / boxed style)
     ============================================================ -->
<div id="sheet-invoice" class="pa-sheet pa-sheet--framed mb-8">
    <!-- In-sheet print button: printSheet(this) climbs to the enclosing
         .pa-sheet; data-print-omit keeps the button itself out of the printout. -->
    <div data-print-omit style="text-align: end;">
        <button type="button" class="pa-btn pa-btn--secondary pa-btn--sm" onclick="pureAdmin.printSheet(this, { title: 'Invoice 2026-0184' })">
            <span aria-hidden="true">🖨️</span> Print this invoice
        </button>
    </div>
    <header class="pa-sheet__masthead pa-sheet__masthead--ruled">
        <div class="pa-sheet__brand">Twin Peaks Ltd.</div>
        <div style="text-align: end;">
            <!-- Barcode on the same row as the number to save vertical space. -->
            <div style="display: flex; align-items: center; justify-content: flex-end; gap: 1.5rem;">
                <div class="pa-sheet__barcode"><svg id="bc-invoice"></svg></div>
                <h1 class="pa-sheet__doctitle" style="color: var(--pc-accent);">INVOICE No. 2026-0184</h1>
            </div>
            <div class="pa-sheet__docmeta">Tax invoice</div>
        </div>
    </header>

    <section class="pa-sheet__parties">
        <div class="pa-sheet__party">
            <span class="pa-sheet__party-label">Supplier</span>
            <span class="pa-sheet__party-name">Twin Peaks Ltd.</span>
            <div class="pa-sheet__party-body">
                251 Fir Avenue<br>
                Twin Peaks, 98065
                <div class="pa-fields pa-fields--horizontal pa-fields--compact pa-fields--no-border mt-2">
                    <div class="pa-field"><span class="pa-field__label">Reg. No.</span><span class="pa-field__value">12345678</span></div>
                    <div class="pa-field"><span class="pa-field__label">VAT No.</span><span class="pa-field__value">GB12345678</span></div>
                    <div class="pa-field"><span class="pa-field__label">Email</span><span class="pa-field__value">billing@twinpeaks.example</span></div>
                </div>
            </div>
        </div>
        <div class="pa-sheet__party pa-sheet__party--strong">
            <span class="pa-sheet__party-label">Bill to</span>
            <span class="pa-sheet__party-name">Great Northern Hotel Ltd.</span>
            <div class="pa-sheet__party-body">
                1 Riverside Drive<br>
                Snoqualmie, 98065
                <div class="pa-fields pa-fields--horizontal pa-fields--compact pa-fields--no-border mt-2">
                    <div class="pa-field"><span class="pa-field__label">Reg. No.</span><span class="pa-field__value">23456789</span></div>
                    <div class="pa-field"><span class="pa-field__label">VAT No.</span><span class="pa-field__value">GB23456789</span></div>
                </div>
            </div>
        </div>
    </section>

    <div class="pc-row">
        <div class="pc-col-100 pc-col-md-50">
            <section class="pa-sheet__meta">
                <span class="pa-sheet__meta-label">Reference No.</span>
                <span class="pa-sheet__meta-value">3048117265</span>
                <span class="pa-sheet__meta-label">Payment code</span>
                <span class="pa-sheet__meta-value">0558</span>
                <span class="pa-sheet__meta-label">Order No.</span>
                <span class="pa-sheet__meta-value">1000883204</span>
            </section>
        </div>
        <div class="pc-col-100 pc-col-md-50">
            <section class="pa-sheet__meta pa-sheet__meta--boxed">
                <span class="pa-sheet__meta-label">Issue date</span>
                <span class="pa-sheet__meta-value">Sep 9, 2026</span>
                <span class="pa-sheet__meta-label">Due date</span>
                <span class="pa-sheet__meta-value">Sep 23, 2026</span>
                <span class="pa-sheet__meta-label">Payment method</span>
                <span class="pa-sheet__meta-value">Bank transfer</span>
                <span class="pa-sheet__meta-label">IBAN</span>
                <span class="pa-sheet__meta-value">GB29 8210 4467 0093 1875 22</span>
            </section>
        </div>
    </div>

    <!-- Line items wrapped in .pa-table-container: scrolls horizontally on a
         narrow screen instead of stretching the sheet (the sheet strips the
         wrapper's frame so it stays invisible on paper). -->
    <div class="pa-table-container">
        <table class="pa-table pa-table--bordered">
            <thead>
                <tr>
                    <th>Description</th>
                    <th class="text-end">Qty</th>
                    <th class="text-end">Unit price</th>
                    <th class="text-end">Discount</th>
                    <th class="text-end">Amount</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <!-- Two-line cell: item name + description stacked in one <td>. -->
                    <td>
                        <span class="pa-table__item-title">Application support</span>
                        <span class="pa-table__item-desc">Business portal maintenance &amp; incident handling — August 2026</span>
                    </td>
                    <td class="text-end">7 days</td>
                    <td class="text-end">7,500.00</td>
                    <td class="text-end">—</td>
                    <td class="text-end">52,500.00</td>
                </tr>
                <tr>
                    <td>
                        <span class="pa-table__item-title">Application support</span>
                        <span class="pa-table__item-desc">Business portal maintenance &amp; incident handling — September 2026</span>
                    </td>
                    <td class="text-end">9 days</td>
                    <td class="text-end">7,500.00</td>
                    <td class="text-end">—</td>
                    <td class="text-end">67,500.00</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Payment QR on the start, totals on the end (totals keeps its
         margin-inline-start:auto, so it stays pushed to the page edge). -->
    <div style="display: flex; align-items: flex-end; gap: 2rem;">
        <div class="pa-sheet__qr" id="qr-invoice">
            <span class="pa-sheet__qr-label">Scan to pay</span>
        </div>
        <section class="pa-sheet__totals">
            <div class="pa-sheet__total-row">
                <span class="pa-sheet__total-label">Subtotal</span>
                <span class="pa-sheet__total-value">120,000.00</span>
            </div>
            <div class="pa-sheet__total-row pa-sheet__total-row--grand">
                <span class="pa-sheet__total-label">Total due</span>
                <span class="pa-sheet__total-value">€120,000.00</span>
            </div>
        </section>
    </div>

    <section class="pa-sheet__notes">
        <p>Twin Peaks Ltd. is not a registered VAT payer.</p>
        <p>Please note that if the due date shown on this invoice is not met, we will charge interest on late payment at the agreed or statutory rate, along with any contractual penalty where one has been agreed.</p>
    </section>

    <footer class="pa-sheet__footer">
        <div class="pa-sheet__signatures">
            <div class="pa-sheet__sign"><span>Issued by</span></div>
            <div class="pa-sheet__sign"><span>Received by</span></div>
            <div class="pa-sheet__sign"><span>Stamp</span></div>
        </div>
        <div class="pa-sheet__legal">
            Registered in the Commercial Register, Section C, File 12345 · Generated by an accounting &amp; invoicing system.
        </div>
    </footer>
</div>


