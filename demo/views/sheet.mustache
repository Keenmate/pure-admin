         .pa-sheet; data-print-omit keeps the button itself out of the printout. -->
    <div data-print-omit style="text-align: end;">
        <button type="button" class="pa-btn pa-btn--secondary pa-btn--sm" onclick="pureAdmin.printSheet(this, { title: 'Invoice 2026-0184' })">
            {{> partials/printer-icon}} Print this invoice
