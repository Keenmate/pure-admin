<!-- ============================================================
     Modifiers + CSS reference
     ============================================================ -->
<div class="pa-card sheet-demo-reference">
    <div class="pa-card__header">
        <div class="pa-card__title">
            <h3 class="pa-card__title-text">CSS Classes Reference</h3>
        </div>
    </div>
    <div class="pa-card__body">
        <h5 class="mt-4">Block &amp; modifiers</h5>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>pa-sheet</code> - A4-width white page, centred, screen shadow, built-in print layer</li>
            <li><code>pa-sheet--framed</code> - Hairline outer border</li>
            <li><code>pa-sheet--compact</code> / <code>--spacious</code> - Tighter / looser padding + region rhythm</li>
            <li><code>pa-sheet--fluid</code> - Fill the container instead of clamping to A4 width</li>
            <li><code>pa-sheet--fill</code> - Full A4-height page; the last region (footer) sinks to the page bottom even when content is short. Prints on exactly one page.</li>
            <li><code>pa-sheet--landscape</code> - A4 landscape (297×210mm) for wide, many-column tables. Best printed on its own via <code>pureAdmin.printElement()</code>, which gives it a landscape page automatically; a whole-page <code>window.print()</code> keeps one orientation, so it stays portrait there.</li>
            <li><code>pa-sheet--print-color</code> - Print the accent/brand colours (title, logo, status) on white paper. Default is pure ink-on-paper.</li>
            <li><code>pa-sheet--print-grayscale</code> - Like <code>--print-color</code>, desaturated to grey. No mode floods the background.</li>
        </ul>

        <h5 class="mt-4">Regions</h5>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>pa-sheet__masthead</code> (<code>--ruled</code>) - Top band; <code>__brand</code>, <code>__logo</code>, <code>__doctitle</code>, <code>__docmeta</code></li>
            <li><code>pa-sheet__parties</code> (<code>--cols-3</code>) - Party grid; <code>__party</code> (<code>--boxed</code> / <code>--strong</code>), <code>__party-label</code>, <code>__party-name</code>, <code>__party-body</code></li>
            <li><code>pa-sheet__meta</code> (<code>--boxed</code>) - Right-aligned label/value grid; <code>__meta-label</code>, <code>__meta-value</code></li>
            <li><code>pa-sheet__title</code> - Generic titled-section heading</li>
            <li><code>pa-sheet__totals</code> (<code>--start</code>) - End-aligned summary column; <code>__total-row</code> (<code>--grand</code>), <code>__total-label</code>, <code>__total-value</code></li>
            <li><code>pa-sheet__notes</code> - Prose block (terms, reminder copy)</li>
            <li><code>pa-sheet__barcode</code> - Barcode slot (inject inline SVG, e.g. Code128 via JsBarcode)</li>
            <li><code>pa-sheet__qr</code> / <code>__qr-label</code> - QR slot with a caption below the code</li>
            <li><code>pa-sheet__footer</code> - <code>__signatures</code> → <code>__sign</code>; <code>__legal</code>; <code>__pageno</code></li>
        </ul>

        <h5 class="mt-4">Compose with existing blocks</h5>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li>Line items → <code>pa-table-container</code> &gt; <code>pa-table</code> (any modifier) — the wrapper scrolls a wide table on mobile; the sheet strips its frame</li>
            <li>Two-line item cell → <code>pa-table__item-title</code> + <code>pa-table__item-desc</code> inside a <code>&lt;td&gt;</code> (name + italic spec/description)</li>
            <li>Metadata / party pairs → <code>pa-fields</code>, <code>pa-desc-table</code></li>
            <li>Tax-breakdown box → <code>pa-table</code> or <code>pa-desc-table</code></li>
            <li>Chapter-style terms → <code>pa-document</code> (numbered clauses)</li>
        </ul>

        <h5 class="mt-4">Runtime tokens (CSS variables)</h5>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>--pa-sheet-width</code> - Page width (default 210mm)</li>
            <li><code>--pa-sheet-height</code> - Page height for <code>--fill</code> on screen (default 297mm)</li>
            <li><code>--pa-sheet-padding</code> - Inner page margin on screen</li>
            <li><code>--pa-sheet-gap</code> - Vertical rhythm between regions</li>
            <li><code>--pa-sheet-rule-color</code> - Masthead/total rule colour</li>
            <li><code>--pa-sheet-totals-width</code> - Width of the totals column (default 42rem)</li>
            <li><code>--pa-sheet-sign-height</code> - Blank height of a signature slot (default 6rem)</li>
            <li><code>--pa-sheet-qr-size</code> - QR code square size (default 12rem)</li>
        </ul>

        <p class="pa-text pa-text--secondary mt-4"><strong>Barcodes &amp; QR codes:</strong> the framework ships only the placement slots (<code>pa-sheet__barcode</code> / <code>pa-sheet__qr</code>) — generate the code itself as <strong>inline SVG</strong> (JsBarcode, a QR library, or a server-rendered image). Use SVG, not <code>&lt;canvas&gt;</code>: a canvas prints blank via <code>printElement()</code> and blurs at print DPI. This demo uses JsBarcode + qrcode-generator (both SVG).</p>

        <h5 class="mt-4">Printing (JavaScript)</h5>
        <ul class="pa-list-basic pa-list-basic--compact">
            <li><code>window.print()</code> - Prints the whole document (use with your own <code>@media print</code> to hide app chrome)</li>
            <li><code>pureAdmin.printElement(target, { title })</code> - Prints a <strong>single element</strong> in isolation. <code>target</code> = element, CSS selector, or event. Clones it into a hidden iframe with the page's styles + theme mode.</li>
            <li><code>pureAdmin.printSheet(this, { title })</code> - From a button inside a sheet; climbs to the enclosing <code>.pa-sheet</code></li>
            <li><code>data-print-omit</code> / <code>.pa-print-hide</code> - Mark elements (e.g. the print button itself) to strip from the printout</li>
        </ul>

        <p class="pa-text pa-text--secondary mt-4">The sheet ships its own <code>@media print</code> rules and a default <code>@page { size: A4 }</code>. The page <strong>margin is intentionally not set</strong> — the browser's own margin (the <em>Margins</em> setting the user picks in the print dialog) governs it; to pin a fixed margin, declare <code>@page { margin: 15mm }</code> after the framework. <code>pureAdmin.printElement()</code> (in <code>src/js/sheet-print.js</code>) is the reliable way to print one sheet without a page-level print stylesheet — the browser has no native single-element print.</p>
    </div>
</div>


<!-- ============================================================
     Barcode + QR generation (demo only)
     The framework ships the placement slots (pa-sheet__barcode /
     pa-sheet__qr); the codes themselves are generated here with two
     tiny libraries, both emitting SVG so they stay crisp in print and
     survive the single-element print clone (a <canvas> would print blank).
     ============================================================ -->
<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/qrcode-generator@1.4.4/qrcode.js"></script>
<script>
(function () {
    function barcode(id, value) {
        var el = document.getElementById(id);
        if (el && window.JsBarcode) {
            JsBarcode(el, value, { format: 'CODE128', height: 26, width: 1, fontSize: 10, margin: 0, displayValue: true });
        }
    }
    function qr(id, value) {
        var el = document.getElementById(id);
        if (el && window.qrcode) {
            var q = qrcode(0, 'M');
            q.addData(value);
            q.make();
            // Insert the SVG as the FIRST child so pa-sheet__qr > svg matches (label stays below).
            el.insertAdjacentHTML('afterbegin', q.createSvgTag({ scalable: true, margin: 1 }));
        }
    }
    barcode('bc-invoice', '2026-0184');
    barcode('bc-order', 'PO-2026-0453');
    barcode('bc-delivery', 'DN-2026-0088');
    qr('qr-invoice', 'https://pay.twinpeaks.example/inv/2026-0184?amount=120000.00&cur=EUR');
    // ZATCA simplified-invoice QR carries seller/VAT/timestamp/total/VAT (TLV in
    // production); a plain payload is fine for the demo's visual.
    qr('qr-zatca', 'ZATCA|Seller=متجر الأصالة|VAT=300123456700003|Time=2026-09-24T14:32:00|Total=488.75|VATAmount=63.75');

    // Print the first invoice in a chosen colour mode. printElement() clones
    // the element synchronously, so we add the modifier, print, then remove it
    // in the same tick — the clone keeps the class and the live page doesn't
    // change (the policy is print-only anyway). mode === '' → default.
    window.printInvoiceMode = function (mode, title) {
        var el = document.getElementById('sheet-invoice');
        if (!el || !window.pureAdmin) return;
        var MODES = ['pa-sheet--print-color', 'pa-sheet--print-grayscale'];
        MODES.forEach(function (m) { el.classList.remove(m); });
        if (mode) el.classList.add(mode);
        pureAdmin.printElement(el, { title: title });
        MODES.forEach(function (m) { el.classList.remove(m); });
    };

    // CN23 item-row stepper. delta -1/+1 nudges the count; 0 = read the input
    // directly (typed value). Adds/removes blank <tr data-cn23-item> rows before
    // the totals row so you can print the form at any item count.
    window.cn23Rows = function (delta) {
        var body = document.getElementById('cn23-rows');
        var input = document.getElementById('cn23-rowcount');
        if (!body || !input) return;
        var min = 1, max = 30;
        var want = (parseInt(input.value, 10) || min) + delta;
        want = Math.max(min, Math.min(max, want));
        input.value = want;
        var rows = body.querySelectorAll('[data-cn23-item]');
        var totals = body.querySelector('[data-cn23-totals]');
        // Remove extras.
        for (var i = rows.length - 1; i >= want; i--) rows[i].remove();
        // Add missing.
        for (var j = rows.length; j < want; j++) {
            var tr = document.createElement('tr');
            tr.setAttribute('data-cn23-item', '');
            tr.innerHTML = '<td class="hr-6"></td><td></td><td></td><td></td><td></td><td></td>';
            body.insertBefore(tr, totals);
        }
    };
})();
</script>
