<!-- Search with More Filters Button -->
<div class="pa-card" id="filter-card">
    <div class="pa-card__header">
        <div class="pa-card__title">
            <h3 class="pa-card__title-text">Expandable Filters</h3>
        </div>
        <p>Search with expandable advanced filters</p>
    </div>
    <div class="pa-card__body">
        <div class="d-flex gap-5 align-items-center flex-wrap">
            <!-- Search by rule -->
            <div class="pa-input-group" style="flex: 1; min-width: 200px;">
                <span class="pa-input-group__prepend"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21 21-4.34-4.34"/><circle cx="11" cy="11" r="8"/></svg></span>
                <input type="text" class="pa-input" placeholder="Search by rule">
            </div>

            <!-- Filter by data source -->
            <div class="pa-input-group" style="flex: 1; min-width: 200px;">
                <span class="pa-input-group__prepend"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg></span>
                <input type="text" class="pa-input" placeholder="Filter by data source">
            </div>

            <!-- Filter by Organization tree -->
            <div class="pa-input-group" style="flex: 1; min-width: 200px;">
                <span class="pa-input-group__prepend"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg></span>
                <input type="text" class="pa-input" placeholder="Filter by Organization tree">
            </div>

            <!-- Action buttons -->
            <button class="pa-btn pa-btn--secondary pa-btn--icon-only" title="Clear all filters"><span class="pa-icon pa-icon--clear" aria-hidden="true"></span></button>
            <button class="pa-btn pa-btn--primary pa-btn--icon-only" title="Refresh"><span class="pa-icon pa-icon--refresh" aria-hidden="true"></span></button>
            <button id="toggle-filters-btn" class="pa-btn pa-btn--primary pa-btn--icon-only" title="More filters" onclick="toggleFilters()"><span class="pa-icon pa-icon--chevron-down" aria-hidden="true"></span></button>
        </div>

        <!-- Advanced Filters (Hidden by default) -->
        <div id="advanced-filters" style="display: none; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--base-border-color);">
            <div class="pc-row">
                <div class="pc-col-100 pc-col-md-1-3">
                    <div class="pa-form-group">
                        <label>Category</label>
                        <div class="pa-input-wrapper">
                            <select class="pa-select">
                                <option>All Categories</option>
                                <option>Electronics</option>
                                <option>Clothing</option>
                                <option>Books</option>
                            </select>
                            <button class="pa-input-wrapper__clear" type="button"><span class="pa-icon pa-icon--x" aria-hidden="true"></span></button>
                        </div>
                    </div>
                </div>
                <div class="pc-col-100 pc-col-md-1-3">
                    <div class="pa-form-group">
                        <label>Price Range</label>
                        <div class="pa-input-wrapper">
                            <select class="pa-select">
                                <option>Any Price</option>
                                <option>Under $50</option>
                                <option>$50 - $100</option>
                                <option>$100 - $500</option>
                                <option>Over $500</option>
                            </select>
                            <button class="pa-input-wrapper__clear" type="button"><span class="pa-icon pa-icon--x" aria-hidden="true"></span></button>
                        </div>
                    </div>
                </div>
                <div class="pc-col-100 pc-col-md-1-3">
                    <div class="pa-form-group">
                        <label>Status</label>
                        <div class="pa-input-wrapper">
                            <select class="pa-select">
                                <option>All Statuses</option>
                                <option>In Stock</option>
                                <option>Out of Stock</option>
                                <option>Pre-order</option>
                            </select>
                            <button class="pa-input-wrapper__clear" type="button"><span class="pa-icon pa-icon--x" aria-hidden="true"></span></button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pc-row">
                <div class="pc-col-100 pc-col-md-50">
                    <div class="pa-form-group">
                        <label>Date Range</label>
                        <div class="pc-row">
                            <div class="pc-col-100 pc-col-md-50">
                                <div class="pa-input-wrapper">
                                    <input type="date" class="pa-input">
                                    <button class="pa-input-wrapper__clear" type="button"><span class="pa-icon pa-icon--x" aria-hidden="true"></span></button>
                                </div>
                            </div>
                            <div class="pc-col-100 pc-col-md-50">
                                <div class="pa-input-wrapper">
                                    <input type="date" class="pa-input">
                                    <button class="pa-input-wrapper__clear" type="button"><span class="pa-icon pa-icon--x" aria-hidden="true"></span></button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="pc-col-100 pc-col-md-50">
                    <div class="pa-form-group">
                        <label>Supplier</label>
                        <div class="pa-input-wrapper">
                            <select class="pa-select">
                                <option>All Suppliers</option>
                                <option>Supplier A</option>
                                <option>Supplier B</option>
                                <option>Supplier C</option>
                            </select>
                            <button class="pa-input-wrapper__clear" type="button"><span class="pa-icon pa-icon--x" aria-hidden="true"></span></button>
                        </div>
                    </div>
                </div>
            </div>

            <div style="text-align: right; margin-top: 0.5rem;">
                <button class="pa-btn pa-btn--secondary">Clear Filters</button>
                <button class="pa-btn pa-btn--primary">Apply Filters</button>
            </div>
        </div>
    </div>
</div>

