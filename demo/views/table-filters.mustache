<script>
function toggleFilters() {
    const filters = document.getElementById('advanced-filters');
    const toggleBtn = document.getElementById('toggle-filters-btn');
    const icon = toggleBtn.querySelector('.pa-icon');
    const isHidden = filters.style.display === 'none';

    filters.style.display = isHidden ? 'block' : 'none';
    icon.className = isHidden ? 'pa-icon pa-icon--chevron-up' : 'pa-icon pa-icon--chevron-down';
    toggleBtn.title = isHidden ? 'Hide filters' : 'More filters';
}
</script>
