<!-- Class Reference -->
<div class="pa-card">
    <div class="pa-card__header">
        <div class="pa-card__title">
            <h3 class="pa-card__title-text">Class Reference</h3>
        </div>
    </div>
    <div class="pa-card__body">
        <table class="pa-table pa-table--striped pa-table--sm">
            <thead>
                <tr>
                    <th>Category</th>
                    <th>Classes</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Font size</td>
                    <td><code>text-{2xs|xs|sm|md|base|lg|xl|2xl|3xl|4xl}</code> (10 / 12 / 14 / 15 / 16 / 18 / 20 / 24 / 28 / 32px)</td>
                </tr>
                <tr>
                    <td>Colour — neutral</td>
                    <td><code>text-body</code>, <code>text-muted</code></td>
                </tr>
                <tr>
                    <td>Colour — roles</td>
                    <td><code>text-{primary|secondary|success|danger|warning|info}</code></td>
                </tr>
                <tr>
                    <td>Colour — slots</td>
                    <td><code>text-color-{1-9}</code></td>
                </tr>
                <tr>
                    <td>Text on colour</td>
                    <td><code>text-on-{role}</code>, <code>text-on-color-{1-9}</code> (pair with <code>bg-*</code>; or use <code>surface-*</code> for both)</td>
                </tr>
                <tr>
                    <td>Weight</td>
                    <td><code>font-weight-{normal|medium|semibold|bold}</code></td>
                </tr>
                <tr>
                    <td>Style</td>
                    <td><code>font-style-{normal|italic}</code></td>
                </tr>
                <tr>
                    <td>Family</td>
                    <td><code>font-family-{system|sans|serif|mono}</code></td>
                </tr>
                <tr>
                    <td>Alignment</td>
                    <td><code>text-start</code>, <code>text-center</code>, <code>text-end</code></td>
                </tr>
                <tr>
                    <td>Wrapping</td>
                    <td><code>text-nowrap</code>, <code>text-truncate</code></td>
                </tr>
                <tr>
                    <td>Vertical</td>
                    <td><code>text-vertical</code>, <code>text-vertical-up</code></td>
                </tr>
                <tr>
                    <td>Semantic</td>
                    <td><code>text-caption</code>, <code>text-lead</code></td>
                </tr>
                <tr>
                    <td>Whole-page scale</td>
                    <td><code>font-size-{small|default|large|xlarge}</code> on <code>&lt;html&gt;</code> — see <a href="/getting-started">Getting Started</a></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
