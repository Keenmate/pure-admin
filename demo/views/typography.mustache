<!-- Text on Colour -->
<div class="pa-card">
    <div class="pa-card__header">
        <div class="pa-card__title">
            <h3 class="pa-card__title-text">Text on Colour</h3>
        </div>
        <p class="pa-card__description"><code>text-on-*</code> is the readable text colour <em>on</em> that background. <code>surface-*</code> sets both at once.</p>
    </div>
    <div class="pa-card__body">
        <h4>Roles — <code>bg-{role}</code> + <code>text-on-{role}</code></h4>
        <div class="d-flex flex-wrap gap-sm mb-4">
            <span class="bg-primary text-on-primary p-sm rounded">text-on-primary</span>
            <span class="bg-secondary text-on-secondary p-sm rounded">text-on-secondary</span>
            <span class="bg-success text-on-success p-sm rounded">text-on-success</span>
            <span class="bg-danger text-on-danger p-sm rounded">text-on-danger</span>
            <span class="bg-warning text-on-warning p-sm rounded">text-on-warning</span>
            <span class="bg-info text-on-info p-sm rounded">text-on-info</span>
        </div>
        <h4>Colour slots — <code>bg-color-N</code> + <code>text-on-color-N</code></h4>
        <div class="d-flex flex-wrap gap-sm">
            <span class="bg-color-1 text-on-color-1 p-sm rounded">text-on-color-1</span>
            <span class="bg-color-2 text-on-color-2 p-sm rounded">text-on-color-2</span>
            <span class="bg-color-3 text-on-color-3 p-sm rounded">text-on-color-3</span>
            <span class="bg-color-4 text-on-color-4 p-sm rounded">text-on-color-4</span>
            <span class="bg-color-5 text-on-color-5 p-sm rounded">text-on-color-5</span>
            <span class="bg-color-6 text-on-color-6 p-sm rounded">text-on-color-6</span>
            <span class="bg-color-7 text-on-color-7 p-sm rounded">text-on-color-7</span>
            <span class="bg-color-8 text-on-color-8 p-sm rounded">text-on-color-8</span>
            <span class="bg-color-9 text-on-color-9 p-sm rounded">text-on-color-9</span>
        </div>
    </div>
</div>

<div class="pc-row">
