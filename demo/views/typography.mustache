<p>Typography — headings, sizes, colours, weights, families, alignment, wrapping, and compound semantic styles. The size scale is absolute: one name, one size, everywhere.</p>

<!-- Headings -->
<div class="pa-card">
    <div class="pa-card__header">
        <div class="pa-card__title">
            <h3 class="pa-card__title-text">Headings</h3>
        </div>
    </div>
    <div class="pa-card__body">
        <h1>Heading 1</h1>
        <h2>Heading 2</h2>
        <h3>Heading 3</h3>
        <h4>Heading 4</h4>
        <h5>Heading 5</h5>
