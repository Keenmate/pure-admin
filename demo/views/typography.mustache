                <div class="pa-card__title">
                    <h3 class="pa-card__title-text">Font Family</h3>
                </div>
            </div>
            <div class="pa-card__body">
                <div class="d-flex flex-column gap-xs">
                    <p class="font-family-system m-0">The quick brown fox — OS UI font <code class="text-nowrap">font-family-system</code></p>
