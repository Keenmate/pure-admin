</div>

<!-- Font Sizes -->
<div class="pa-card">
    <div class="pa-card__header">
        <div class="pa-card__title">
            <h3 class="pa-card__title-text">Font Sizes</h3>
        </div>
        <p class="pa-card__description">No class = the 16px body default. Each <code>text-*</code> is one fixed size.</p>
    </div>
    <div class="pa-card__body">
        <div class="d-flex flex-column gap-xs">
            <p class="text-2xs m-0"><code>text-2xs</code> — 10px</p>
            <p class="text-xs m-0"><code>text-xs</code> — 12px (badges, labels, captions)</p>
            <p class="text-sm m-0"><code>text-sm</code> — 14px (buttons, inputs, tables, tabs)</p>
            <p class="text-md m-0"><code>text-md</code> — 15px (sidebar / nav items)</p>
            <p class="text-base m-0"><code>text-base</code> — 16px (body default; same as no class)</p>
            <p class="text-lg m-0"><code>text-lg</code> — 18px</p>
            <p class="text-xl m-0"><code>text-xl</code> — 20px</p>
            <p class="text-2xl m-0"><code>text-2xl</code> — 24px</p>
            <p class="text-3xl m-0"><code>text-3xl</code> — 28px</p>
            <p class="text-4xl m-0"><code>text-4xl</code> — 32px</p>
        </div>
    </div>
</div>

