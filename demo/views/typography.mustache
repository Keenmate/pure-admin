<div class="pc-row">
    <div class="pc-col-100 pc-col-md-2-3">
        <!-- Wrapping -->
        <div class="pa-card">
            <div class="pa-card__header">
                <div class="pa-card__title">
                    <h3 class="pa-card__title-text">Wrapping</h3>
                </div>
                <p class="pa-card__description">Each box is 25rem wide (<code>wr-25</code>).</p>
            </div>
            <div class="pa-card__body">
                <p class="text-sm text-muted mb-1">Default — wraps</p>
                <div class="wr-25 p-xs mb-3" style="background: var(--pc-subtle-bg);">A long line of text that is too wide for its box, so it wraps onto the next line.</div>
                <p class="text-sm text-muted mb-1"><code>text-nowrap</code> — stays on one line and overflows</p>
                <div class="wr-25 p-xs mb-3 text-nowrap overflow-hidden" style="background: var(--pc-subtle-bg);">A long line of text that is too wide for its box, so it is cut off at the edge.</div>
                <p class="text-sm text-muted mb-1"><code>text-truncate</code> — one line, ends with …</p>
                <div class="wr-25 p-xs text-truncate" style="background: var(--pc-subtle-bg);">A long line of text that is too wide for its box, so it ends with an ellipsis.</div>
            </div>
        </div>
    </div>
    <div class="pc-col-100 pc-col-md-1-3">
        <!-- Vertical Text -->
        <div class="pa-card">
            <div class="pa-card__header">
                <div class="pa-card__title">
                    <h3 class="pa-card__title-text">Vertical Text</h3>
                </div>
                <p class="pa-card__description">For narrow column headers and spine labels.</p>
            </div>
            <div class="pa-card__body">
                <div class="d-flex gap-lg">
                    <span class="text-vertical p-xs" style="background: var(--pc-subtle-bg);"><code>text-vertical</code></span>
                    <span class="text-vertical-up p-xs" style="background: var(--pc-subtle-bg);"><code>text-vertical-up</code></span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Semantic Text -->
<div class="pa-card">
