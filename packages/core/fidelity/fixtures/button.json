    },
    {
      "name": "outline-secondary",
      "props": {
        "variant": "secondary",
        "outline": true,
        "label": "Secondary"
      },
      "golden": "<button type=\"button\" class=\"pa-btn pa-btn--outline-secondary\">Secondary</button>"
    },
    {
      "name": "outline-success",
      "props": {
        "variant": "success",
        "outline": true,
        "label": "Success"
      },
      "golden": "<button type=\"button\" class=\"pa-btn pa-btn--outline-success\">Success</button>"
    },
    {
      "name": "outline-warning",
      "props": {
        "variant": "warning",
        "outline": true,
        "label": "Warning"
      },
      "golden": "<button type=\"button\" class=\"pa-btn pa-btn--outline-warning\">Warning</button>"
    },
    {
      "name": "outline-danger",
      "props": {
        "variant": "danger",
        "outline": true,
        "label": "Danger"
      },
      "golden": "<button type=\"button\" class=\"pa-btn pa-btn--outline-danger\">Danger</button>"
    },
    {
      "name": "outline-color-5",
      "props": {
        "themeColor": "5",
        "outline": true,
        "label": "Slot 5"
      },
      "golden": "<button type=\"button\" class=\"pa-btn pa-btn--outline-color-5\">Slot 5</button>",
      "note": "themeColor + outline exercises the outlineProduces path (pa-btn--outline-color-{n})."
    },
    {
      "name": "align-start",
      "props": {
