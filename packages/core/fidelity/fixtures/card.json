{
  "//": "Markup-fidelity fixture for the card component. See ../README.md and button.json for the model. Goldens are the canonical rc05 card shape: header only when a header-ish prop is present, body always, footer only when footer/footerActions present. Title is ALWAYS .pa-card__title > .pa-card__title-text (icon optional), never a bare <h3>.",
  "component": "card",
  "block": "pa-card",
  "propsVocabulary": {
    "variant": "whole-card colour (primary|success|warning|danger|color-1..9) — NO info/secondary",
    "stat": "boolean — stat-card style (pa-card--stat)",
    "ghost": "boolean — no bg/border/shadow",
    "liveState": "up|down|neutral — persistent tinted background",
    "noPadding": "boolean — remove body padding",
    "title": "header title text",
    "titleIcon": "glyph rendered in pa-card__title-icon before the title",
    "description": "inline header description (pa-card__description)",
    "subtitle": "muted header byline (pa-card__meta)",
    "headerUnderlined": "boolean — accent border under header",
    "headerUnderlineColor": "success|warning|danger|info — underline colour (needs headerUnderlined)",
    "headerUnderlineThemeColor": "1..9 theme-slot underline colour (needs headerUnderlined)",
    "headerWrap": "boolean — allow header description to wrap",
    "body": "main body content",
    "footer": "footer content",
    "footerActions": "footer actions (wrapped in pa-card__actions)",
    "headerActions": "header actions (wrapped in pa-card__actions)",
    "headerActionsCollapsed": "compact fallback for the header actions → pa-card__actions--responsive with __actions-full / __actions-collapsed",
    "titleTooltip": "boolean — tooltip on the title text showing its full text, only while truncated",
    "titleTooltipPlacement": "bottom|start|end (top = default)",
    "titleTooltipVariant": "primary|success|warning|danger|color-1..9",
    "titleTooltipMultiline": "boolean",
    "titleTooltipIsHelp": "boolean",
    "titleTooltipIsKeyword": "boolean",
    "titleTooltipAlways": "boolean — show even when not truncated",
    "descriptionTooltip": "boolean — tooltip on the description showing its full text, only while truncated",
    "descriptionTooltipPlacement": "bottom|start|end (top = default)",
    "descriptionTooltipVariant": "primary|success|warning|danger|color-1..9",
    "descriptionTooltipMultiline": "boolean",
    "descriptionTooltipIsHelp": "boolean",
    "descriptionTooltipIsKeyword": "boolean",
    "descriptionTooltipAlways": "boolean — show even when not truncated"
  },
  "goldenConventions": "Structural only — cards add no attribute conventions like button's type. Slot content is a plain text token (Body/Tools/etc.) so the diff checks the wrapper's structural nesting, not rich content. Attribute + class-token order are normalized away.",
  "features": {
    "//": "Feature→class contract authored from dist/css/main.css. capability.mjs axis-1 reverse-check is scoped to block modifiers (pa-card--*); element modifiers (pa-card__header--*, __body--*) are verified forward (feature produces → exists in CSS).",
    "variant":                   { "kind": "enum", "options": ["primary", "success", "warning", "danger", "color-1", "color-2", "color-3", "color-4", "color-5", "color-6", "color-7", "color-8", "color-9"], "produces": "pa-card--{value}" },
    "stat":                      { "kind": "bool", "produces": "pa-card--stat" },
    "ghost":                     { "kind": "bool", "produces": "pa-card--ghost" },
    "liveState":                 { "kind": "enum", "options": ["up", "down", "neutral"], "produces": "pa-card--live-{value}" },
    "noPadding":                 { "kind": "bool", "produces": "pa-card__body--no-padding" },
    "headerUnderlined":          { "kind": "bool", "produces": "pa-card__header--underlined" },
    "headerUnderlineColor":      { "kind": "enum", "options": ["success", "warning", "danger", "info"], "produces": "pa-card__header--underline-{value}" },
    "headerUnderlineThemeColor": { "kind": "enum", "options": ["1", "2", "3", "4", "5", "6", "7", "8", "9"], "produces": "pa-card__header--underline-color-{value}" },
    "headerWrap":                { "kind": "bool", "produces": "pa-card__header--wrap" },
    "title":                     { "kind": "string", "produces": null, "note": "structural — pa-card__title > pa-card__title-text" },
    "titleIcon":                 { "kind": "slot", "produces": "pa-card__title-icon" },
    "description":               { "kind": "string", "produces": "pa-card__description" },
    "subtitle":                  { "kind": "string", "produces": "pa-card__meta" },
    "body":                      { "kind": "slot", "produces": "pa-card__body" },
    "footer":                    { "kind": "slot", "produces": "pa-card__footer" },
    "footerActions":             { "kind": "slot", "produces": "pa-card__actions", "note": "in footer" },
    "headerActions":             { "kind": "slot", "produces": "pa-card__actions", "note": "in header" },
    "headerActionsCollapsed":    { "kind": "slot", "produces": "pa-card__actions--responsive", "note": "presence switches the header actions to the CSS-only --responsive swap: headerActions → __actions-full, this → __actions-collapsed" },
    "tabs":                      { "kind": "slot", "produces": "pa-card__tabs", "note": "tab strip INSIDE the header, after the title (canonical per snippets/cards.html). Tab buttons/panels are the card-tab / card-tab-content fragments." },
    "inlineTabs":                { "kind": "bool", "produces": "pa-card__tabs--inline", "note": "compact pill style; the tab strip still lives in the header" },
    "titleTooltip":               { "kind": "bool", "produces": "pa-tooltip", "note": "tooltip ON the h3.pa-card__title-text (pa-tooltip pa-tooltip--floating + data-tooltip = its text + data-pa-tooltip-overflow → shown only while truncated)" },
    "titleTooltipPlacement":      { "kind": "enum", "options": ["bottom", "start", "end"], "produces": "pa-tooltip--{value}", "note": "top is the default (no class)" },
    "titleTooltipVariant":        { "kind": "enum", "options": ["primary", "success", "warning", "danger", "color-1", "color-2", "color-3", "color-4", "color-5", "color-6", "color-7", "color-8", "color-9"], "produces": "pa-tooltip--{value}" },
    "titleTooltipMultiline":      { "kind": "bool", "produces": "pa-tooltip--multiline" },
    "titleTooltipIsHelp":         { "kind": "bool", "produces": "pa-tooltip--help" },
    "titleTooltipIsKeyword":      { "kind": "bool", "produces": "pa-tooltip--keyword" },
    "titleTooltipAlways":         { "kind": "bool", "note": "drops data-pa-tooltip-overflow → shown even when the text fits" },
    "descriptionTooltip":         { "kind": "bool", "produces": "pa-tooltip", "note": "tooltip ON the p.pa-card__description (pa-tooltip pa-tooltip--floating + data-tooltip = its text + data-pa-tooltip-overflow → shown only while truncated)" },
    "descriptionTooltipPlacement": { "kind": "enum", "options": ["bottom", "start", "end"], "produces": "pa-tooltip--{value}", "note": "top is the default (no class)" },
    "descriptionTooltipVariant":  { "kind": "enum", "options": ["primary", "success", "warning", "danger", "color-1", "color-2", "color-3", "color-4", "color-5", "color-6", "color-7", "color-8", "color-9"], "produces": "pa-tooltip--{value}" },
    "descriptionTooltipMultiline": { "kind": "bool", "produces": "pa-tooltip--multiline" },
    "descriptionTooltipIsHelp":   { "kind": "bool", "produces": "pa-tooltip--help" },
    "descriptionTooltipIsKeyword": { "kind": "bool", "produces": "pa-tooltip--keyword" },
    "descriptionTooltipAlways":   { "kind": "bool", "note": "drops data-pa-tooltip-overflow → shown even when the text fits" }
  },
  "deferred": {
    "//": "Element classes covered by a fragment fixture (verified against it) or acknowledged out-of-scope. See README 'deferred'. { fixture: X } is verified: capability confirms X's goldens/produces actually include the class.",
    "pa-card__tab":                 { "fixture": "card-tab" },
    "pa-card__tab--active":         { "fixture": "card-tab" },
    "pa-card__tab-content":         { "fixture": "card-tab-content" },
    "pa-card__tab-content--active": { "fixture": "card-tab-content" },
    "pa-card__actions-full":        "CORE-ONLY responsive-actions subtree — author-provided inside the :tools slot; NO wrapper component emits it (keen docs: author supplies both -full/-collapsed). Not wrapper-fidelity-testable.",
    "pa-card__actions-collapsed":   "CORE-ONLY responsive-actions subtree — see pa-card__actions-full."
  },
  "cssStateClasses": {
    "//": "Wrapper-emitted __actions modifiers driven by the header_actions_collapsed slot (CSS container query) or is_actions_overflow (JS). Claimed here; dedicated scenarios owed.",
    "pa-card__actions--overflow": "JS progressive-collapse toolbar",
    "pa-card__actions--responsive": "container-query collapse (needs -full/-collapsed subtrees)"
  },
